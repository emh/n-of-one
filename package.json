{
  "name": "n-of-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --config workers/api/wrangler.toml",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "deploy:worker": "wrangler deploy --config workers/api/wrangler.toml",
    "test:worker": "node tests/worker-integration.mjs",
    "test:parser:live": "node tests/parser-live.mjs",
    "format": "prettier --write src shared workers/api/src tests vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb": "^8.0.3",
    "lucide-preact": "^1.47.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "prettier": "^3.9.8",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.135.0"
  }
}
